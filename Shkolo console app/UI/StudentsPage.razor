@inject School School
@inject SchoolStorage Storage

<Rows>
    <SubTabs Items="@(new[] { "List", "Add student", "Add class", "Add grade", "Remove" })" Selected="@view" SelectedChanged="@((string v) => { view = v; message = ""; ClearInputs(); })" />

    @if (view == "List")
    {
    <Panel Title="Students" Border="BoxBorder.Rounded" BorderColor="@Color.DeepSkyBlue1" Expand="true">
        @if (School.Students.Count == 0)
        {
            <Markup Content="No students yet. Open the Add student tab." Foreground="@Color.Grey70" />
        }
        else
        {
            <SpectreTable Expand="true" Border="TableBorder.Rounded">
                <SpectreTHead>
                    <SpectreTR>
                        <SpectreTH Align="Justify.Left">Class</SpectreTH>
                        <SpectreTH Align="Justify.Right">No.</SpectreTH>
                        <SpectreTH Align="Justify.Left">Name</SpectreTH>
                        <SpectreTH Align="Justify.Right">Grades</SpectreTH>
                        <SpectreTH Align="Justify.Right">Average</SpectreTH>
                    </SpectreTR>
                </SpectreTHead>
                <SpectreTBody>
                    @foreach (Student student in School.Students.OrderBy(s => s.ClassName, StringComparer.OrdinalIgnoreCase).ThenBy(s => s.Id))
                    {
                        double average = student.GetAverageGrade();
                        <SpectreTR>
                            <SpectreTD>@student.ClassName</SpectreTD>
                            <SpectreTD>@student.Id</SpectreTD>
                            <SpectreTD>@student.FirstName @student.LastName</SpectreTD>
                            <SpectreTD>@student.Grades.Count</SpectreTD>
                            <SpectreTD>
                                <Markup Content="@(average == 0 ? "-" : average.ToString("F2"))"
                                        Foreground="@Helpers.GradeColor(average)" Decoration="@Decoration.Bold" />
                            </SpectreTD>
                        </SpectreTR>
                    }
                </SpectreTBody>
            </SpectreTable>
        }
    </Panel>

    }
    else if (view == "Add student")
    {
    <Panel Title="Add student" Border="BoxBorder.Rounded" Expand="true">
        <Rows>
            <Markup Content="Full Name:" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
            <FormInput @bind-Value="fullName" Placeholder="e.g. Ivan Petrov" Expand="true" />
            <Markup Content="Class:" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
            <FormInput @bind-Value="className" Placeholder="e.g. 10A" Expand="true" />
            <TextButton Content="  Add student  " OnClick="AddStudent" BackgroundColor="@Color.Green" FocusedColor="@Color.Lime" />
        </Rows>
    </Panel>

    }
    else if (view == "Add class")
    {
        <Panel Title="Add a whole class" Border="BoxBorder.Rounded" Expand="true">
            <Rows>
                @if (!bulkStarted)
                {
                    <Markup Content="Class:" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
                    <FormInput @bind-Value="bulkClass" Placeholder="e.g. 10A" Expand="true" />
                    <Markup Content="Number of students:" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
                    <FormInput @bind-Value="bulkCountText" Placeholder="e.g. 15" Expand="true" />
                    <TextButton Content="  Start  " OnClick="StartBulk" BackgroundColor="@Color.Green" FocusedColor="@Color.Lime" />
                }
                else
                {
                    <Markup Content="@($"Class {bulkClass} - student {bulkNames.Count + 1} of {bulkCount}")" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
                    @if (bulkNames.Count > 3)
                    {
                        <Markup Content="@($"... {bulkNames.Count - 3} more entered")" Foreground="@Color.Grey70" />
                    }
                    @foreach (string entered in bulkNames.Skip(Math.Max(0, bulkNames.Count - 3)))
                    {
                        <Markup Content="@("  " + entered)" Foreground="@Color.Green" />
                    }
                    <FormInput @key="bulkNames.Count" @bind-Value="bulkCurrent" OnSubmit="SubmitBulkName" Placeholder="Full name, then press Enter" Expand="true" />
                    <TextButton Content="  Cancel  " OnClick="ResetBulk" BackgroundColor="@Color.DarkRed" FocusedColor="@Color.Red" />
                }
            </Rows>
        </Panel>
    }
    else if (view == "Add grade")
    {
        <Panel Title="Add grade" Border="BoxBorder.Rounded" Expand="true">
            @if (School.Subjects.Count == 0)
            {
                <Markup Content="Add a subject first (Subjects tab)." Foreground="@Color.Yellow" />
            }
            else
            {
                <Rows>
                    <Select Options="@StudentOptions" @bind-Value="gradeStudent" Placeholder="Choose student" Expand="true" />
                    <Select Options="@SubjectOptions" @bind-Value="gradeSubject" Placeholder="Choose subject" Expand="true" />
                    <FormInput Label="Grade (2-6)" @bind-Value="gradeValue" Placeholder="e.g. 5.50" Expand="true" />
                    <TextButton Content="  Add grade  " OnClick="AddGrade" BackgroundColor="@Color.Green" FocusedColor="@Color.Lime" />
                </Rows>
            }
        </Panel>
    }
    else
    {
        <Panel Title="Remove student" Border="BoxBorder.Rounded" Expand="true">
            <Rows>
                <Markup Content="Class:" Foreground="@Color.Red" Decoration="@Decoration.Bold" />
                <FormInput @bind-Value="removeClass" Placeholder="e.g. 10E" Expand="true" />
                <Markup Content="Number in class or full name:" Foreground="@Color.Red" Decoration="@Decoration.Bold" />
                <FormInput @bind-Value="removeStudent" OnSubmit="Remove" Placeholder="e.g. 3  or  Ivan Petrov" Expand="true" />
                <TextButton Content="@(confirmRemove ? "  Click again to CONFIRM removal  " : "  Remove student  ")"
                            OnClick="Remove"
                            BackgroundColor="@Color.DarkRed"
                            FocusedColor="@Color.Red" />
            </Rows>
        </Panel>
    }

    @if (message != "")
    {
        <Markup Content="@message" Foreground="@(isError ? Color.Red : Color.Green)" Decoration="@Decoration.Bold" />
    }
</Rows>

@code {
    private string view = "List";
    private string fullName = "";
    private string className = "";

    private string gradeStudent = "";
    private string gradeSubject = "";
    private string gradeValue = "";

    private string removeStudent = "";
    private string removeClass = "";
    private bool confirmRemove;
    private Student? confirmRemoveStudent;

    private string message = "";
    private bool isError;

    private string[] StudentOptions => School.Students
        .OrderBy(s => s.ClassName, StringComparer.OrdinalIgnoreCase).ThenBy(s => s.Id)
        .Select(Helpers.Label).ToArray();
    private string[] SubjectOptions => School.Subjects.Select(Helpers.Label).ToArray();

    private Student? StudentFromLabel(string label) =>
        School.Students.FirstOrDefault(s => Helpers.Label(s) == label);


    private void AddStudent()
    {
        string[] parts = (fullName ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            Show("Enter the full name (first and last name).", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(className))
        {
            Show("Enter the class (e.g. 10E).", true);
            return;
        }

        string cls = className.Trim();
        int number = School.NextStudentNumber(cls);
        School.AddStudent(new Student(number, parts[0], parts[1], cls));
        Storage.Save(School);
        fullName = "";
        className = "";
        Show($"Student added to {cls} with number {number}.", false);
        view = "List";
    }

    private string bulkClass = "";
    private string bulkCountText = "";
    private int bulkCount;
    private bool bulkStarted;
    private string bulkCurrent = "";
    private List<string> bulkNames = [];

    // Empties every input so nothing typed earlier is still there when a tab is opened.
    private void ClearInputs()
    {
        fullName = "";
        className = "";
        gradeStudent = "";
        gradeSubject = "";
        gradeValue = "";
        removeStudent = "";
        removeClass = "";
        confirmRemove = false;
        confirmRemoveStudent = null;
        ResetBulk();
    }

    private void ResetBulk()
    {
        bulkStarted = false;
        bulkClass = "";
        bulkCountText = "";
        bulkCurrent = "";
        bulkCount = 0;
        bulkNames = [];
    }

    private void StartBulk()
    {
        if (string.IsNullOrWhiteSpace(bulkClass))
            Show("Enter the class (e.g. 10A).", true);
        else if (!int.TryParse(bulkCountText.Trim(), out bulkCount) || bulkCount < 1 || bulkCount > 100)
            Show("Number of students must be between 1 and 100.", true);
        else
        {
            bulkClass = bulkClass.Trim();
            bulkNames = [];
            bulkCurrent = "";
            bulkStarted = true;
            message = "";
        }
    }

    private void SubmitBulkName()
    {
        string[] parts = (bulkCurrent ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            Show("Enter the full name (first and last name).", true);
            return;
        }

        bulkNames.Add(string.Join(' ', parts));
        bulkCurrent = "";
        message = "";

        if (bulkNames.Count < bulkCount) return;

        foreach (string name in bulkNames)
        {
            string[] p = name.Split(' ', 2);
            School.AddStudent(new Student(School.NextStudentNumber(bulkClass), p[0], p[1], bulkClass));
        }
        Storage.Save(School);
        string text = $"Class {bulkClass}: {bulkNames.Count} students added.";
        ResetBulk();
        Show(text, false);
        view = "List";
    }

    private void AddGrade()
    {
        Student? student = StudentFromLabel(gradeStudent);
        Subject? subject = School.Subjects.FirstOrDefault(s => s.Id == Helpers.ParseId(gradeSubject));

        if (student == null)
            Show("Choose a student.", true);
        else if (subject == null)
            Show("Choose a subject.", true);
        else if (!Helpers.TryParseGrade(gradeValue, out double value) || value < 2 || value > 6)
            Show("Grade must be a number between 2 and 6.", true);
        else
        {
            int id = Helpers.NextId(School.Students.SelectMany(s => s.Grades).Select(g => g.Id));
            student.AddGrade(new Grade(id, value, subject));
            Storage.Save(School);
            gradeValue = "";
            Show($"Grade {value:0.##} in {subject.Name} added to {student.FirstName}.", false);
        }
    }

    private void Remove()
    {
        string query = (removeStudent ?? "").Trim();
        string cls = (removeClass ?? "").Trim();
        bool hasClass = cls != "";
        Student? student;

        if (int.TryParse(query, out int number))
        {
            // A number only means something together with its class.
            if (!hasClass)
            {
                confirmRemove = false;
                Show("Enter the class - the same number exists in every class.", true);
                return;
            }
            student = School.FindStudent(cls, number);
        }
        else
        {
            List<Student> matches = School.Students
                .Where(s => string.Equals($"{s.FirstName} {s.LastName}", query, StringComparison.OrdinalIgnoreCase)
                            && (!hasClass || string.Equals(s.ClassName, cls, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            if (matches.Count > 1)
            {
                confirmRemove = false;
                Show($"{matches.Count} students match - enter the class or use the number in class.", true);
                return;
            }
            student = matches.FirstOrDefault();
        }

        if (student == null)
        {
            confirmRemove = false;
            Show(hasClass
                ? "No student found with that number/name in that class."
                : "No student found with that full name.", true);
            return;
        }

        if (!confirmRemove || confirmRemoveStudent != student)
        {
            confirmRemove = true;
            confirmRemoveStudent = student;
            Show($"Remove {student.ClassName} no. {student.Id} - {student.FirstName} {student.LastName}? Press the button again to confirm.", true);
            return;
        }

        confirmRemove = false;
        confirmRemoveStudent = null;
        School.RemoveStudent(student.ClassName, student.Id);
        Storage.Save(School);
        removeStudent = "";
        removeClass = "";
        Show($"{student.FirstName} {student.LastName} removed.", false);
    }

    private void Show(string text, bool error)
    {
        message = text;
        isError = error;
    }
}
